# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SUPABASE_PROJECT_ID=your_supabase_project_id

# Auto Restart Configuration
ENABLE_AUTO_RESTART=true

# Subscription Error Monitoring
# Error threshold: How many subscription errors in 5 minutes before considering it a serious problem
# Default: 20 (if you get false restart triggers, increase to 30-50)
SUBSCRIPTION_ERROR_THRESHOLD=20

# Node Environment
NODE_ENV=production
