{
  "name": "cursor-remote-server",
  "version": "1.0.0",
  "description": "Cursor远程控制服务器端",
  "main": "src/services/supabaseService.js",
  "type": "module",
  "scripts": {
    "start": "node src/services/supabaseService.js",
    "dev": "nodemon src/services/supabaseService.js",
    "monitor": "node connection-monitor.js",
    "auto-restart": "node auto-restart.js",
    "production": "node auto-restart.js",
    "fix-stuck": "node fix-stuck-commands.js",
    "smart-restart": "../scripts/smart-restart.sh restart",
    "smart-start": "../scripts/smart-restart.sh start",
    "smart-stop": "../scripts/smart-restart.sh stop",
    "smart-status": "../scripts/smart-restart.sh status",
    "smart-monitor": "../scripts/smart-restart.sh monitor",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "test:verbose": "node --experimental-vm-modules node_modules/.bin/jest --verbose"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^2.0.15",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/index.js"
    ],
    "forceExit": true
  }
}
