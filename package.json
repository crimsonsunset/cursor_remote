{
  "name": "cursor-remote-root",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "config": {
    "locale": "en",
    "supportedLocales": ["en", "zh"]
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/start.js\"",
